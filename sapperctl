#!/usr/bin/env python3
"""Manage this checkout's local Sapper Web instance."""
import argparse
import contextlib
import errno
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time

if os.name != "posix" or sys.version_info < (3, 10):
    sys.exit("需要 Python 3.10+ 和 POSIX 环境；Windows 请在 WSL2 内运行。")

import fcntl
import socket

REPO = Path(__file__).resolve().parent
sys.path.insert(0, str(REPO / "lib"))
import sapper_models
from sapper_auth import AuthStore, manage_credentials
from sapper_web import (
    CLAUDE_STARTUP_WARNING, Console, FINISHED, PORT_IN_USE_EXIT, WebError,
    private_json, read_json, warn_root_startup,
)


def default_config():
    return {"root": str(REPO / "runs"), "port": 8766}


def web_args(config, state):
    return [str(REPO / "lib/sapper_web.py"), "--state", str(state),
            "--root", config["root"], "--port", str(config["port"])]


def workspace_status(args, state):
    settings = state / "sapperctl.json"
    config = read_json(settings, default_config())
    root = args.root.expanduser().resolve() if args.root else Path(config["root"])
    if settings.exists() and root != Path(config["root"]):
        raise WebError("请使用该实例记录的任务根目录")
    app = Console(root, state, initialize=False)
    path = Path(args.workspace or ".").expanduser().resolve()
    project = next((p for p in app.projects() if p["id"] == args.workspace or Path(p["path"]) == path), None)
    if project is None:
        raise WebError("工作区不在该实例中，请核对 --state、--root 和 --workspace")
    snapshot = app.workspace_status(project["id"])
    fields = ("id", "role_label", "name", "run_id", "claude_session_id", "profile_name", "observation")
    agents = [{key: a.get(key) for key in fields} for a in snapshot["agents"]]
    if args.json:
        print(json.dumps({"project": project, "agents": agents, "summary": snapshot["summary"],
                          "observed_at": snapshot["observed_at"]}, ensure_ascii=False, indent=2))
        return
    print(f"{project['name']} · {project['id']} · {project['status']}\n{project['path']}")
    print(f"{project['goal']}\n事实 {project['facts']} · 待办 {project['open_intents']} · 待确认 {project['pending_confirmation']}")
    print(f"观测于 {snapshot['observed_at']}")
    for agent in agents:
        observation = agent["observation"]
        print(f"{agent['name'] or agent['role_label']} · {agent['id']} · {observation['status']} · {observation['evidence']}")


def cwd_of(pid):
    proc = Path(f"/proc/{pid}/cwd")
    if sys.platform.startswith("linux"):
        return proc.resolve(strict=True)
    if not shutil.which("lsof"):
        raise RuntimeError("接管相对路径启动的旧服务需要 lsof。")
    result = subprocess.run(["lsof", "-nP", "-a", "-p", str(pid), "-d", "cwd", "-Fn"],
                            capture_output=True, text=True)
    for line in result.stdout.splitlines():
        if line.startswith("n"):
            return Path(line[1:]).resolve()
    raise RuntimeError(f"无法核实 PID {pid} 的工作目录。")


def web_pids(state, config):
    # Match complete invocations, including the repository/state. Never signal
    # a process based on its name, port, or a persisted PID alone.
    commands = {" ".join(web_args(config, state)): False}
    if state == REPO / ".sapper-web" and config == default_config():
        for entry in ("lib/sapper.py web", "lib/sapper_web.py"):
            commands[entry] = True
            commands[str(REPO / entry)] = False
    listing = subprocess.check_output(["ps", "-axww", "-o", "uid=,pid=,command="], text=True, errors="replace")
    found = []
    for row in listing.splitlines():
        fields = row.strip().split(None, 2)
        if len(fields) != 3 or fields[0] != str(os.getuid()):
            continue
        for command, relative in commands.items():
            executable, sep, tail = fields[2].rpartition(" " + command)
            if not sep or tail or not re.fullmatch(r"python(?:[0-9.]+)?", Path(executable).name, re.I):
                continue
            if "/" in executable and not Path(executable).is_file():
                continue
            pid = int(fields[1])
            try:
                if not relative or cwd_of(pid) == REPO:
                    found.append(pid)
            except FileNotFoundError:
                pass  # exited while being inspected
            break
    return found


def port_available(port):
    with socket.socket() as probe:
        probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            probe.bind(("127.0.0.1", port))
        except OSError as exc:
            if exc.errno == errno.EADDRINUSE:
                return False
            raise RuntimeError(f"端口 {port} 不可用，未确认服务归属：{exc}") from exc
    return True


def stop_web(state, config, *, require_free_port=True):
    pids = web_pids(state, config)
    if len(pids) > 1:
        raise RuntimeError("发现多个匹配的 Web 服务，请先核对启动参数。")
    if pids:
        try:
            os.kill(pids[0], signal.SIGTERM)
        except ProcessLookupError:
            pass
        for _ in range(60):
            if pids[0] not in web_pids(state, config):
                break
            time.sleep(0.1)
        else:
            raise RuntimeError("Web 尚未退出。")
    if require_free_port and not port_available(config["port"]):
        raise RuntimeError(f"端口 {config['port']} 仍被占用，未确认服务归属。")
    print("Web 已停止。")


def start(state, config):
    warn_root_startup()
    settings = state / "sapperctl.json"
    saved = read_json(settings)
    found = web_pids(state, config)
    if found:
        if len(found) != 1:
            raise RuntimeError("发现多个匹配的 Web 服务。")
        if saved is None:
            private_json(settings, config)
        print(f"Web 已在运行（PID {found[0]}）。")
        return

    first_port = config["port"]
    written = None
    try:
        for port in range(first_port, 65536):
            if not port_available(port):
                continue
            candidate = dict(config, port=port)
            if port != first_port:
                candidate.setdefault("requested_port", first_port)
            if candidate != saved:
                # Record the arguments before spawning so an interrupted controller can find the child.
                private_json(settings, candidate)
                written = candidate
            child = launch_web(state, candidate)
            if child is None:
                continue  # Another process bound the port between the probe and startup.
            if port != first_port:
                print(f"端口 {first_port} 已被占用，改用 {port}。")
            print(f"Web 已启动（PID {child}）：http://127.0.0.1:{port}/")
            return
        raise RuntimeError(f"端口 {first_port}–65535 均被占用。")
    except Exception:
        if written is not None and not web_pids(state, written):
            if saved is None:
                settings.unlink(missing_ok=True)
            else:
                private_json(settings, saved)
        raise


def launch_web(state, config):
    path = state / "web-server.log"
    actions = [
        (os.POSIX_SPAWN_OPEN, 0, os.devnull, os.O_RDONLY, 0),
        (os.POSIX_SPAWN_OPEN, 1, str(path), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600),
        (os.POSIX_SPAWN_DUP2, 1, 2),
    ]
    with path.open("a+b") as log:
        log.seek(0, os.SEEK_END)
        ready = f"Sapper Web: http://127.0.0.1:{config['port']}/\n".encode()
        child = os.posix_spawn(sys.executable, [sys.executable, *web_args(config, state)],
                               os.environ.copy(), file_actions=actions, setsid=True)
        warning_prefix = CLAUDE_STARTUP_WARNING.encode()
        startup_warnings = []
        for _ in range(100):
            pid, status = os.waitpid(child, os.WNOHANG)
            if pid:
                if os.waitstatus_to_exitcode(status) == PORT_IN_USE_EXIT:
                    return None
                break
            # The child logs this only after binding the socket. An unrelated listener can't satisfy it.
            lines = log.readlines()
            startup_warnings.extend(line for line in lines if line.startswith(warning_prefix))
            if ready in lines:
                for warning in startup_warnings:
                    print(warning.decode(errors="replace"), end="", file=sys.stderr)
                return child
            time.sleep(0.1)
        else:
            with contextlib.suppress(ProcessLookupError):
                os.kill(child, signal.SIGTERM)
    raise RuntimeError(f"Web 未就绪，请检查 {path}")


def live_runs(state, config):
    """Live runs are those whose managed host PID still matches its recorded birth."""
    from sapper_processes import process_table
    try:
        rows = process_table()
    except (OSError, ValueError, subprocess.SubprocessError):
        return []
    live = []
    for path in (state / "runs").glob("*/run.json"):
        record = read_json(path, {})
        host_path = path.parent / "host.json"
        if not host_path.exists():
            continue  # legacy run predating the headless host
        try:
            host = read_json(host_path, {})
        except (OSError, ValueError):
            continue
        pid, birth = host.get("pid"), host.get("birth")
        row = rows.get(pid) if isinstance(pid, int) else None
        if row and (not birth or row["birth"] == birth) and record.get("status") not in FINISHED:
            live.append(record)
    return live


def stop_managed(state, config):
    if (state / "runs").exists() or (state / "agents").exists():
        app = Console(Path(config["root"]), state)
        with app.workspaces.lifecycle():
            runs = live_runs(state, config)
            for path in (state / "agents").glob("*.json"):
                agent = read_json(path)
                if agent.get("run_id") and agent.get("desired_state") == "running" and not agent.get("deleted_at"):
                    app.workspaces.mark_stopped(agent["id"])
            for run in sorted(runs, key=lambda r: r.get("role") != "watchdog"):
                if run["status"] not in FINISHED:
                    app.stop(run["id"])
            # Physically reap every managed host record, including finished runs
            # that may have left orphan tool processes.
            app.stop_all_runs()
            if live_runs(state, config):
                raise RuntimeError("仍有受管无头进程，模型桥保留；可重新执行 stop。")
    for bridge in sapper_models.bridge_operation(state):
        sapper_models.bridge_operation(state, bridge["id"])
    for ready in (state / "model-bridges").glob("*/ready.json"):
        # An unavailable bridge must not be reported as stopped if its recorded PID lives.
        pid = read_json(ready, {}).get("pid")
        if isinstance(pid, int) and pid > 0:
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                continue
        raise RuntimeError("仍有未确认退出的模型桥，请检查 status。")
    print("受管任务及模型桥已关闭。")


def main():
    parser = argparse.ArgumentParser(description="Sapper 本地服务管理（macOS / Linux / WSL2）")
    parser.add_argument("action", choices=["start", "stop", "status", "restart", "stop-web", "claude-status", "stop-claude", "auth-init", "password-reset", "workspace-status"],
                        help="stop 关闭整套受管服务；restart 和 stop-web 只操作网页")
    parser.add_argument("--state", type=Path, default=REPO / ".sapper-web", help="实例状态目录")
    parser.add_argument("--port", type=int, help="首次 start 的起始端口，默认 8766，占用时逐一递增")
    parser.add_argument("--root", type=Path, help="首次 start 的任务根目录")
    parser.add_argument("--username", help="auth-init 或 password-reset 的管理员用户名")
    parser.add_argument("--workspace", help="workspace-status 的工作区 ID 或目录，默认当前目录")
    parser.add_argument("--json", action="store_true", help="workspace-status 输出 JSON")
    args = parser.parse_args()
    if args.username and args.action not in ("auth-init", "password-reset"):
        parser.error("--username 只能用于 auth-init 或 password-reset")
    state = args.state.expanduser().resolve()
    if args.action == "workspace-status":
        workspace_status(args, state)
        return
    if args.workspace is not None or args.json:
        parser.error("--workspace 和 --json 只能用于 workspace-status")
    os.umask(0o077)
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (state / "sapperctl.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if args.action in ("auth-init", "password-reset"):
            manage_credentials(state, args.action, args.username)
            return
        settings = state / "sapperctl.json"
        config = read_json(settings, default_config())
        requested = dict(config)
        if args.port is not None:
            if not 1 <= args.port <= 65535:
                parser.error("--port 需要 1–65535")
            if args.port != config.get("requested_port"):
                requested["port"] = args.port
        if args.root:
            requested["root"] = str(args.root.expanduser().resolve())
        if requested != config and (settings.exists() or args.action != "start" or
                                    web_pids(state, config) or any((state / "runs").glob("*/run.json"))):
            parser.error("已有实例使用原配置。新配置请用 start --state 选择独立目录。")
        if args.action in ("claude-status", "stop-claude"):
            executable = shutil.which("claude")
            if not executable:
                raise RuntimeError("当前环境找不到 Claude Code CLI。")
            argv = [executable, "daemon", "status"] if args.action == "claude-status" else [executable, "daemon", "stop", "--any"]
            result = subprocess.run(argv, check=False, timeout=30)
            if result.returncode:
                raise RuntimeError(f"Claude daemon 命令退出码 {result.returncode}。")
            return
        if args.action == "status":
            pids = web_pids(state, config)
            print("Web：" + (", ".join(map(str, pids)) if pids else "未发现匹配进程"))
            print(f"目录：{state}\n地址：http://127.0.0.1:{config['port']}/")
            print(f"受管无头进程：{len(live_runs(state, config))}")
            print(f"在线模型桥：{len(sapper_models.bridge_operation(state))}")
            return
        if args.action in ("restart", "stop", "stop-web"):
            stop_web(state, config, require_free_port=args.action != "restart")
        if args.action == "stop":
            stop_managed(state, config)
        if args.action in ("start", "restart"):
            start(state, requested)
            if not AuthStore(state).configured():
                print("请在本机初始化管理员：" + shlex.join(["./sapperctl", "auth-init", "--state", str(state)]))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError, WebError, EOFError, subprocess.SubprocessError) as error:
        sys.exit(f"sapperctl：{error}")
